  <data key="d3">TLB</data>
  <data key="d4">4</data>
  <data key="d5"></data>
  <data key="d6"></data>
</node>
<node id="emat">
  <data key="d0">Effective Memory Access Time</data>
  <data key="d1">Formula</data>
